# Smart Incentive Calculator Environment Variables

# Not required for basic functionality
# Add to Vercel dashboard if needed

# API Base URL (for future backend integration)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Feature Flags
# NEXT_PUBLIC_ENABLE_TEAM_COMPARISON=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_SETTINGS=true

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=your-id

# Note: NEXT_PUBLIC_* variables are exposed to the browser
# Never store sensitive data in these variables
